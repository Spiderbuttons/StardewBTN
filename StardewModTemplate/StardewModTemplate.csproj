<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(SolutionDir)common.targets" />
    <PropertyGroup>
        <AssemblyName>StardewModTemplate</AssemblyName>
        <RootNamespace>StardewModTemplate</RootNamespace>
        <Version>1.0.0</Version>
        <ModFolderName>StardewModTemplate</ModFolderName>
        <Title>StardewModTemplate</Title>
    </PropertyGroup>
    <!--#if (EnableTranslations) -->
    
    <ItemGroup>
        <PackageReference Include="Pathoschild.Stardew.ModTranslationClassBuilder" Version="2.*" />
    </ItemGroup>
    <PropertyGroup>
        <TranslationClassBuilder_ClassName>i18n</TranslationClassBuilder_ClassName>
        <TranslationClassBuilder_AddGetByKey>true</TranslationClassBuilder_AddGetByKey>
        <TranslationClassBuilder_AddKeyMap>true</TranslationClassBuilder_AddKeyMap>
    </PropertyGroup>
    <!--#endif -->
    <!--#if (EnablePublicizer) -->
    
    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.*">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <Publicize Include="StardewModdingAPI" />
        <Publicize Include="Stardew Valley" />
        <Publicize Include="StardewValley.GameData" />
    </ItemGroup>
    <!--#endif -->
</Project>